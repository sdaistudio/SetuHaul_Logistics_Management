# SetuHaul server settings. load-env.sh builds /opt/setuhaul/.env from: this file (non-secret defaults)
# -> computed DOMAIN / TWILIO_WEBHOOK_BASE_URL -> /opt/setuhaul/settings.env (your overrides) -> SSM /setuhaul/* (secrets).
# Never put a secret in this file: it is committed. Blank values are skipped.
# Every variable the code reads (app.py, setuhaul/*.py, setuhaul/channels/*.py) is listed here.

# ---- channel (setuhaul/settings.py)
CHANNEL=twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_INTERACTIVE=false
TWILIO_SANDBOX=true
# TWILIO_WEBHOOK_BASE_URL is computed as https://$DOMAIN (must be exactly the URL pasted in Twilio)
TWILIO_WEBHOOK_BASE_URL=
# Content API SIDs from scripts/create_twilio_content.py (optional; used only if TWILIO_INTERACTIVE=true)
TWILIO_CONTENT_QR1=
TWILIO_CONTENT_QR2=
TWILIO_CONTENT_QR3=
# Approved template SIDs (optional; without them proactive messages are BLOCKED with an alarm, by design)
TWILIO_TPL_DRIVER_CHECKIN_SID=
TWILIO_TPL_DRIVER_BOOKING_UPDATE_SID=
TWILIO_TPL_STAFF_PAGE_SID=
OUTBOX_WORKER=1
SIM_URL=

# ---- clock and demo world (setuhaul/clock.py, app.py)
CLOCK_MODE=snapshot
SNAPSHOT_ANCHOR=2026-08-04T09:15:00+05:30
DEMO_WORLD=1
# SETUHAUL_DB is set by docker-compose.yml to /data/demo_world.db (a COPY of the snapshot)
SETUHAUL_REWIND_TO=
# Needed for /dev/clock and /auth/dev-login. Safe here because Caddy exposes only the Twilio webhooks
# and /healthz; those endpoints answer only on 127.0.0.1:8000 (reach them through an SSM session).
SETUHAUL_DEV=1
DUTY_HEAD_PHONE=

# ---- hostname (deploy only)
# DOMAIN defaults to <elastic-ip-with-dashes>.sslip.io; override in /opt/setuhaul/settings.env (e.g. DuckDNS)
DOMAIN=

# ---- sessions (setuhaul/session_store.py): set by docker-compose.yml to redis://redis:6379/0
REDIS_URL=

# ---- optional LLM fallback and tracing (setuhaul/llm.py, setuhaul/tracing.py)
SETUHAUL_LLM_MODEL=claude-haiku-4-5
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setuhaul-demo

# ---- optional voice notes (setuhaul/voice/): speech models, not an LLM. off | openrouter | sarvam | selfhosted
#   openrouter  OpenRouter /audio endpoints, default ElevenLabs Scribe v2 + Eleven v3; key in SSM /setuhaul/OPENROUTER_API_KEY
#   sarvam      Sarvam AI Saaras (speech-to-text) + Bulbul (text-to-speech); key in SSM /setuhaul/SARVAM_API_KEY
#   selfhosted  prototype/speech/ on a GPU box (AI4Bharat IndicConformer + Indic Parler-TTS); token in SSM /setuhaul/VOICE_SERVER_TOKEN
VOICE=off
VOICE_SERVER_URL=
OPENROUTER_STT_MODEL=elevenlabs/scribe-v2
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v3
# an ElevenLabs voice id (empty = provider default); deny = only providers that do not train on the audio
OPENROUTER_TTS_VOICE=
OPENROUTER_DATA_COLLECTION=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=
# public base for /media/<token>.mp3; empty = TWILIO_WEBHOOK_BASE_URL
MEDIA_BASE_URL=

# ---- legacy Meta Cloud API and Cognito (not used in this deployment; left blank on purpose)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---- SECRETS: never here. Stored by deploy/aws/put_secrets.sh in SSM as SecureString:
#   /setuhaul/TWILIO_ACCOUNT_SID  /setuhaul/TWILIO_AUTH_TOKEN  /setuhaul/ANTHROPIC_API_KEY  /setuhaul/LANGSMITH_API_KEY
#   /setuhaul/OPENROUTER_API_KEY  /setuhaul/SARVAM_API_KEY  /setuhaul/VOICE_SERVER_TOKEN (optional, voice)
#   /setuhaul/SETUHAUL_DEV_SECRET (generated)  /setuhaul/DEMO_PHONE  /setuhaul/DEMO_PHONES (personal data)
# and by create_bucket.sh as a plain String: /setuhaul/BACKUP_BUCKET
