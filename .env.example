# Copy to .env (never commit .env). Every secret comes from the environment or a secret store.
# Channel: twilio (live WhatsApp via Twilio), sim (local simulator, scripts/sim_server.py), console (offline default)
CHANNEL=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# The WhatsApp Sandbox sender, with the whatsapp: prefix
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public base URL Twilio calls (ngrok). Must match the Sandbox "When a message comes in" URL host exactly.
TWILIO_WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.app
# true: quick-reply / list-picker via Content API (needs TWILIO_CONTENT_* below); false: numbered text
TWILIO_INTERACTIVE=false
# Sandbox pacing (1 message / 3 s) and sandbox-only template variable mapping
TWILIO_SANDBOX=true
# From scripts/create_twilio_content.py --create
TWILIO_CONTENT_QR1=
TWILIO_CONTENT_QR2=
TWILIO_CONTENT_QR3=
# Approved templates for business-initiated messages (see templates/twilio_templates.yaml). Unset -> not sent + ops alarm.
TWILIO_TPL_DRIVER_CHECKIN_SID=
TWILIO_TPL_DRIVER_BOOKING_UPDATE_SID=
TWILIO_TPL_STAFF_PAGE_SID=
# Clock: live (real time) or snapshot (the 4 Aug 2026 world runs forward from the anchor)
CLOCK_MODE=snapshot
SNAPSHOT_ANCHOR=2026-08-04T09:15:00+05:30
# Database copy made by scripts/seed_demo_phones.py (never the supplied snapshot)
SETUHAUL_DB=out/demo_world.db
# Last step of the missed-SLA chain
DUTY_HEAD_PHONE=
# Optional
REDIS_URL=
ANTHROPIC_API_KEY=
# 1 only on a laptop; never on a public server (scripts/live_start.sh needs 1 for /dev/clock)
SETUHAUL_DEV=0
# LLM reader for messages the rules can't read: off | anthropic | agentcore. Unset = today's behaviour
# (the direct Claude reader if ANTHROPIC_API_KEY is set, otherwise rules only). See prototype/agent/README.md.
READER=
# READER=agentcore: the setuhaul-reader runtime ARN and its region. EC2 needs bedrock-agentcore:InvokeAgentRuntime on it.
AGENTCORE_READER_ARN=
AWS_REGION=
# Salts the AgentCore session id (a hash of driver id + date). Any random string; keep it in a secret store.
SETUHAUL_SESSION_SALT=
