# Local keys for running SetuHaul on your laptop (VS Code). Copy to prototype/.env and fill in.
# prototype/.env is git-ignored: never commit real keys. On the server, keys live in AWS SSM (deploy/aws/put_secrets.sh).

# ---- voice notes (setuhaul/voice/): off | openrouter | sarvam | selfhosted
VOICE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=elevenlabs/scribe-v2
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v3
# optional: an ElevenLabs voice id; "deny" = only providers that do not train on the audio
OPENROUTER_TTS_VOICE=
OPENROUTER_DATA_COLLECTION=
# public https base WhatsApp fetches spoken replies from (your ngrok URL when testing with Twilio)
MEDIA_BASE_URL=

# ---- other backends (only if VOICE is set to them)
SARVAM_API_KEY=
VOICE_SERVER_URL=
VOICE_SERVER_TOKEN=

# ---- WhatsApp via Twilio (see README: WhatsApp through Twilio)
CHANNEL=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_BASE_URL=

# ---- optional LLM fallback for messages the rules cannot read
ANTHROPIC_API_KEY=
